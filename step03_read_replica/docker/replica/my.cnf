[mysqld]
# Replica サーバー ID（Primary と異なる値を使う）
server-id                    = 2

# Relay Log 設定
relay_log                    = relay-bin
relay_log_index              = relay-bin.index

# Binary Log（Replica 自身のログ - カスケードレプリケーション用）
log_bin                      = mysql-bin
binlog_format                = ROW

# GTID（Primary と一致させる）
gtid_mode                    = ON
enforce_gtid_consistency     = ON

# 読み取り専用設定（重要！Replica への誤書き込みを防ぐ）
read_only                    = ON
super_read_only              = ON

# Replica のエラー回避設定
replica_skip_errors          = ddl_exist_errors

# Slow Query Log
slow_query_log               = 1
slow_query_log_file          = /var/log/mysql/slow.log
long_query_time              = 1

# 文字コード
character-set-server         = utf8mb4
collation-server             = utf8mb4_unicode_ci

# 最大接続数（読み取り専用なのでやや多め）
max_connections              = 300

# InnoDB Buffer Pool
innodb_buffer_pool_size      = 256M
