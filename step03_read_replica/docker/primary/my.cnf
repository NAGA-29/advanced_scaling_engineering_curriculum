[mysqld]
# Primary サーバー ID（各ノードで一意である必要がある）
server-id                    = 1

# Binary Log 設定（レプリケーションに必須）
log_bin                      = mysql-bin
binlog_format                = ROW
binlog_row_image             = FULL
expire_logs_days             = 7
max_binlog_size              = 100M

# GTID（Global Transaction Identifier）による一貫したレプリケーション
gtid_mode                    = ON
enforce_gtid_consistency     = ON

# 耐久性設定（本番向け: クラッシュ時のデータ損失を最小化）
sync_binlog                  = 1
innodb_flush_log_at_trx_commit = 1

# Slow Query Log
slow_query_log               = 1
slow_query_log_file          = /var/log/mysql/slow.log
long_query_time              = 1
log_queries_not_using_indexes = 1

# 文字コード
character-set-server         = utf8mb4
collation-server             = utf8mb4_unicode_ci

# 最大接続数
max_connections              = 200

# InnoDB Buffer Pool（コンテナの RAM に合わせて調整）
innodb_buffer_pool_size      = 256M
