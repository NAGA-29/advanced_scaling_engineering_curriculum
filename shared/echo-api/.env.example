# Copy this file to .env and adjust values for your environment.
# The application reads configuration exclusively from environment variables.

# MySQL DSN in the format understood by go-sql-driver/mysql.
# See: https://github.com/go-sql-driver/mysql#dsn-data-source-name
DB_DSN=root:secret@tcp(127.0.0.1:3306)/app?parseTime=true&charset=utf8mb4

# Redis server address (host:port).
REDIS_ADDR=127.0.0.1:6379

# Set to false to disable Redis and use the no-op in-memory cache.
REDIS_ENABLED=true

# TCP port the HTTP server listens on.
APP_PORT=8080
